{
  "name": "markdown-web-viewer",
  "version": "1.0.0",
  "private": true,
  "description": "Single-file markdown viewer (static, no build step). This package.json exists only for the CI harness tooling.",
  "scripts": {
    "start": "node server.js",
    "test:unit": "node --test test/*.test.mjs",
    "test:e2e": "node test/harness.mjs",
    "test": "node --test test/*.test.mjs && node test/harness.mjs",
    "lint": "eslint ."
  },
  "devDependencies": {
    "playwright": "^1.56.1",
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "globals": "^17.12.0"
  },
  "type": "module"
}
